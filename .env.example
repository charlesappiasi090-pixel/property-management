APP_NAME=PropertyHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=UTC
APP_URL_PATH=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=propertyhub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@propertyhub.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# PropertyHub — tenant & domain configuration
# ---------------------------------------------------------------------------
PROPERTYHUB_CURRENCY=USD
PROPERTYHUB_CURRENCY_SYMBOL=$
PROPERTYHUB_TIMEZONE=UTC
# Days before lease end that an expiry warning is raised
PROPERTYHUB_LEASE_EXPIRY_WARNING_DAYS=60
# Days a rent invoice stays "due" before it is reported as overdue
PROPERTYHUB_RENT_GRACE_DAYS=5
# Allow a business to keep operating after its subscription lapses (dev only)
PROPERTYHUB_GRACE_ON_SUBSCRIPTION=false

# ---------------------------------------------------------------------------
# PropertyHub — secure document storage
# ---------------------------------------------------------------------------
# Private disk backing Document/Attachment models. "local" is private by
# definition (files live outside public/ and are only reachable through a
# signed, permission-checked controller route).
PROPERTYHUB_DOCUMENTS_DISK=local
# Max upload size in kilobytes enforced by the document upload form request
PROPERTYHUB_DOCUMENTS_MAX_KB=10240
# Restrict uploads to an allow-list of MIME types
PROPERTYHUB_DOCUMENTS_ALLOWED_MIME="application/pdf,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain"

# ---------------------------------------------------------------------------
# Debugging aids — LEAVE FALSE IN PRODUCTION
# ---------------------------------------------------------------------------
# Naming the missing permission/role inside a 403 page speeds up development
# but leaks your permission model to end users, so gate it behind an env flag.
PERMISSION_DISPLAY_IN_EXCEPTIONS=false
ROLE_DISPLAY_IN_EXCEPTIONS=false
